    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:setup:pilot": "vitest run --config vitest.live.config.mts",
    "eval:setup:add": "vitest run --config vitest.live.config.mts tests/live/setup-add.live.ts",
    "eval:review:line": "vitest run --config vitest.live.config.mts tests/live/review-line.live.ts",
    "plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-execution-plan.ts",
    "plan:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-plan-format.ts",
    "verify:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-sql-verify.ts",
    "stack:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stack-status.ts"
  },
  "name": "momentum-app",
  "private": "true"
}
