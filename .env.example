# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (public: safe for the browser, RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role (server only. Never prefix with NEXT_PUBLIC_, never import on the client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CAPTCHA on sign-up, sign-in and the password reset request (MOM-64). Both are public by design (the widget runs in
# the browser). Leave the site key unset to show no CAPTCHA, as in local development. The provider is `turnstile`
# (the default) or `hcaptcha`. The matching secret goes only in the Supabase dashboard (Authentication, Attack
# Protection), never in this file.
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-captcha-site-key
# NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile

# Signs the short-lived cookie that lets a password reset link (token link, MOM-122) open the new-password page. Server
# only. At least 32 characters; generate one in a password manager (or `openssl rand -base64 48`) and use a different
# value for Production and Preview. Without it the token reset link is refused and only the older code link works.
RECOVERY_COOKIE_SECRET=generate-a-random-value-of-at-least-32-characters

# Anthropic (Claude API, server only)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Hevy (strength training integration, server only; used from MOM-13 onward)
HEVY_API_KEY=your-hevy-api-key

# Google OAuth client (Calendar integration, MOM-37 and MOM-62; server only: starts the consent flow, exchanges the
# code and refreshes access tokens). In the Google Cloud console, add an Authorized redirect URI for every origin the
# app runs on: http://localhost:3000/api/auth/callback/google and https://<your domain>/api/auth/callback/google.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
